load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//.bazel:defs.bzl", "go_test")

go_library(
    name = "fx",
    srcs = [
        "fx.go",
        "fxs.go",
    ],
    importpath = "github.com/ava-labs/avalanchego/vms/platformvm/fx",
    visibility = ["//visibility:public"],
    deps = [
        "//ids",
        "//snow",
        "//vms/components/verify",
        "//vms/secp256k1fx",
    ],
)

go_test(
    name = "fx_test",
    srcs = [
        "fxs_test.go",
        "mocks_generate_test.go",
    ],
    embed = [":fx"],
    deps = [
        "//vms/platformvm/stakeable",
        "//vms/secp256k1fx",
        "//vms/warpfx",
        "@com_github_stretchr_testify//require",
    ],
)
